+const seed = await handle.read()
+const generation = await handle.prepareObservationRecovery?.()
+const session = ctx.sessions.prepare(id, {
+  meta: handle.header, seed: seed.events, inheritedEventCount: handle.inheritedEventCount,
+  eventState: seed.eventState, observationRecovery: generation,
