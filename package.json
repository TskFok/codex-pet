{
  "name": "codex-pet",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24.9.0 <25"
  },
  "scripts": {
    "test": "pnpm --filter @codex-pet/desktop --filter @codex-pet/deepseek-integration --fail-if-no-match -r test && node --test scripts/desktop-pet/release-scripts.test.mjs",
    "typecheck": "pnpm --filter @codex-pet/desktop --filter @codex-pet/deepseek-integration --fail-if-no-match -r typecheck",
    "build": "pnpm --filter @codex-pet/desktop --filter @codex-pet/deepseek-integration --fail-if-no-match -r build",
    "tauri": "pnpm --filter @codex-pet/desktop tauri",
    "prepare:resources": "node scripts/desktop-pet/prepare-resources.mjs",
    "validate:release": "node scripts/desktop-pet/validate-release.mjs"
  }
}
