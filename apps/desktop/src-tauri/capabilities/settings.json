{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-window",
  "description": "用户主动管理设置和来源配置",
  "windows": [
    "settings"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-settings",
    "allow-update-settings",
    "allow-get-deepseek-activity-status",
    "allow-test-deepseek-connection",
    "allow-trigger-pet-activity",
    "allow-list-pets",
    "allow-choose-pet-directory",
    "allow-import-pet-package",
    "allow-integration-status",
    "allow-apply-integration"
  ]
}
