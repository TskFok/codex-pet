index 0000000000..23d56431e7
--- /dev/null
+++ b/packages/session/session-persistence-jsonl/tests/fixtures/recovery-tail-writer.mjs
@@ -0,0 +1,27 @@
+/** Built persistence process fixture. The test kills it with an observed, buffered tail. */
+import { writeSync } from 'node:fs'
+import { Context } from '@deepseek-ai/cordis'
+import SessionStore from '@deepseek-ai/dsh-session'
+import * as JsonlSessionPersistence from '@deepseek-ai/dsh-session-persistence-jsonl'
+
+const [root, id] = process.argv.slice(2)
+const ctx = new Context()
+await ctx.plugin(SessionStore)
+await ctx.plugin(JsonlSessionPersistence, { root, compression: 'none' })
+const handle = await ctx.sessionPersistence.open(id, 'write')
+const seed = await handle.read()
+const generation = await handle.prepareObservationRecovery?.()
+const session = ctx.sessions.prepare(id, {
+  meta: handle.header, seed: seed.events, inheritedEventCount: handle.inheritedEventCount,
+  eventState: seed.eventState, observationRecovery: generation,
+})
+const suffix = session.snapshotEvents(seed.events.length)
+await handle.append(suffix)
+ctx.sessions.enter(session)
+ctx.sessions.announce(session)
+const seen = []
+ctx.on('session/event', (owner, event) => { if (session === owner) seen.push(event) })
+session.append('turn/start', { turn: 2 })
+session.append('turn/end', { turn: 2, reason: { kind: 'completed' } })
+writeSync(1, JSON.stringify({ generation, seedCount: session.firstLiveSeq, seen }) + '\n')
+process.kill(process.pid, 'SIGKILL')
diff --git a/packages/session/session-persistence-jsonl/tests/observation-recovery.e2e.ts b/packages/session/session-persistence-jsonl/tests/observation-recovery.e2e.ts
