diff --git a/apps/desktop/tests/session-deep-link.spec.ts b/apps/desktop/tests/session-deep-link.spec.ts
new file mode 100644
index 0000000000..a4564180f9
--- /dev/null
+++ b/apps/desktop/tests/session-deep-link.spec.ts
@@ -0,0 +1,32 @@
+import { describe, expect, it } from 'vitest'
+import { DesktopSessionLinks, parseSessionDeepLink } from '../src/session-deep-link.ts'
+
+describe('桌面精确会话入口', () => {
+  it('只接受单个编码会话标识，拒绝其他地址及无效编码', () => {
+    expect(parseSessionDeepLink('dsh://session/%E4%BC%9A%E8%AF%9D%2Fa')).toBe('会话/a')
+    for (const url of ['dsh://open', 'dsh://session/', 'dsh://session/a/b', 'dsh://session/%ZZ', 'dsh://session/a?x=1', 'https://session/a']) expect(parseSessionDeepLink(url)).toBeUndefined()
+  })
+  it('冷启动早到与workspace未就绪均排队，就绪后提醒且确认前保留', () => {
+    const links = new DesktopSessionLinks()
+    const updates: string[] = []
+    links.accept('dsh://session/cold')
+    expect(links.pending(false)).toEqual([])
+    links.attach(() => { updates.push('ready') })
+    expect(updates).toEqual(['ready'])
+    expect(links.pending(true)).toEqual([{ id: 1, sessionId: 'cold' }])
+    expect(links.pending(true)).toHaveLength(1)
+    links.acknowledge(1)
+    expect(links.pending(true)).toEqual([])
+  })
+  it('热启动、隐藏窗口和Windows second-instance保留目标而非仅唤起', () => {
+    const links = new DesktopSessionLinks()
+    let wakes = 0
+    links.attach(() => { wakes++ })
+    links.acceptArgv(['app.exe', 'dsh://session/win'])
+    links.accept('dsh://session/hot')
+    expect(wakes).toBe(3)
+    expect(links.pending(true).map(value => value.sessionId)).toEqual(['win', 'hot'])
+    links.acknowledge(999)
+    expect(links.pending(true)).toHaveLength(2)
+  })
+})
