{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "pet-window",
  "description": "桌宠渲染与只读提醒",
  "windows": [
    "pet"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-runtime-info",
    "allow-record-diagnostic",
    "allow-pointer-input",
    "allow-update-hit-region",
    "allow-pet-snapshot",
    "allow-get-snapshot",
    "allow-get-settings",
    "allow-get-playback",
    "allow-get-pet-asset",
    "allow-play-alert"
  ]
}
