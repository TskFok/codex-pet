diff --git a/packages/session/session-persistence-jsonl/src/observation-recovery.ts b/packages/session/session-persistence-jsonl/src/observation-recovery.ts
new file mode 100644
index 0000000000..b0ebb8d9c2
--- /dev/null
+++ b/packages/session/session-persistence-jsonl/src/observation-recovery.ts
@@ -0,0 +1,219 @@
+/** Observation receipts and durable birth evidence owned by the JSONL writer lease. */
+import { createHash, randomUUID } from 'node:crypto'
+import { lstat, open, readFile, readdir, rename, rm } from 'node:fs/promises'
+import { dirname, join } from 'node:path'
+import { SessionObservationToken, type SessionEvent, type SessionObservationAncestor, type SessionObservationBirthRange, type SessionObservationRecovery } from '@deepseek-ai/dsh-session'
+
+const RECEIPT_PREFIX = '.observation-v1-'
+const ANCESTOR_LIMIT = 128
+const RECEIPT_BYTES = 32 * 1024
+const TOKEN = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/
+const SHA256 = /^[0-9a-f]{64}$/
+
+type Receipt = SessionObservationRecovery & { readonly prefixSha256: string }
+
+/** The published observation and its writer-only append witness. */
+export interface ObservationWriter {
+  readonly recovery: SessionObservationRecovery
+  readonly recordBirths: (batch: readonly SessionEvent[]) => Promise<void>
+}
+
+function record(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value)
+}
+
+function offset(value: unknown): value is number {
+  return typeof value === 'number' && Number.isSafeInteger(value) && value >= 0
+}
+
+function token(value: unknown): value is string {
+  return typeof value === 'string' && TOKEN.test(value)
+}
+
+function checksum(value: unknown): value is string {
+  return typeof value === 'string' && SHA256.test(value)
+}
+
+async function readRecord(path: string): Promise<unknown> {
+  const info = await lstat(path)
+  if (!info.isFile() || info.size > RECEIPT_BYTES) throw new Error('Invalid observation evidence file')
+  return JSON.parse(await readFile(path, 'utf8'))
+}
+
+async function readPrevious(directory: string): Promise<Receipt | undefined> {
+  const names = await readdir(directory)
+  const indexes = names
+    .map(name => name.match(/^\.observation-v1-([1-9][0-9]*)\.json$/)?.[1])
+    .filter(value => value !== undefined)
+    .map(value => Number(value))
+  if (indexes.length === 0) return undefined
+  const generation = indexes.reduce((latest, value) => Math.max(latest, value), 0)
+  if (!offset(generation) || generation !== indexes.length) throw new Error('Incomplete observation receipt chain')
+  const data = await readRecord(join(directory, `${RECEIPT_PREFIX}${generation}.json`))
+  if (!record(data) || (data.version !== 1 && data.version !== 2) || data.generation !== generation
+    || !token(data.streamId) || !token(data.epochId) || !offset(data.recoveredEventCount)
+    || !Array.isArray(data.ancestors) || data.ancestors.length !== Math.min(generation - 1, ANCESTOR_LIMIT)
+    || !checksum(data.prefixSha256)) {
+    throw new Error('Invalid observation receipt')
+  }
+  const ancestors: SessionObservationAncestor[] = []
+  let priorSequence = 0
+  for (const [index, ancestor] of data.ancestors.entries()) {
+    const expected = generation - data.ancestors.length + index
+    if (!record(ancestor) || !token(ancestor.epochId) || ancestor.generation !== expected
+      || !offset(ancestor.firstSequence) || ancestor.firstSequence < priorSequence
+      || ancestor.firstSequence > data.recoveredEventCount) {
+      throw new Error('Invalid writer ancestry')
+    }
+    const verifiedBirths = data.version === 2 && ancestor.verifiedBirths !== undefined
+      ? birthRange(ancestor.verifiedBirths, ancestor.firstSequence, data.recoveredEventCount)
+      : undefined
+    priorSequence = ancestor.firstSequence
+    ancestors.push(Object.freeze({
+      epochId: SessionObservationToken(ancestor.epochId), generation: expected, firstSequence: priorSequence,
+      ...verifiedBirths === undefined ? {} : { verifiedBirths },
+    }))
+  }
+  const common = {
+    generation, ancestors,
+    streamId: SessionObservationToken(data.streamId),
+    epochId: SessionObservationToken(data.epochId),
+    recoveredEventCount: data.recoveredEventCount, prefixSha256: data.prefixSha256,
+  }
+  if (data.version === 1) return { ...common, version: 1 }
+  if (!offset(data.firstLiveSequence) || data.firstLiveSequence < data.recoveredEventCount) {
+    throw new Error('Invalid live sequence boundary')
+  }
+  return { ...common, version: 2, firstLiveSequence: data.firstLiveSequence }
+}
+
+function birthRange(value: unknown, minimum: number, maximum: number): SessionObservationBirthRange {
+  if (!record(value) || !offset(value.firstSequence) || !offset(value.eventCount)
+    || value.firstSequence < minimum || value.eventCount <= value.firstSequence || value.eventCount > maximum) {
+    throw new Error('Invalid durable birth interval')
+  }
+  return Object.freeze({ firstSequence: value.firstSequence, eventCount: value.eventCount })
+}
+
+function canonical(_key: string, value: unknown): unknown {
+  if (!record(value)) return value
+  return Object.fromEntries(Object.keys(value).sort().map(key => [key, value[key]]))
+}
+
+function prefixHash(events: readonly SessionEvent[], count: number, version: 1 | 2): ReturnType<typeof createHash> {
+  const hash = createHash('sha256')
+  for (let index = 0; index < count; index++) {
+    hash.update(JSON.stringify(events[index], version === 1 ? undefined : canonical) + '\n')
+  }
+  return hash
+}
+
+function birthsPath(directory: string, generation: number): string {
+  return join(directory, `.observation-births-v2-${generation}.json`)
+}
+
+function mayContainTimedBirth({ type, data }: { type: string; data: unknown }): boolean {
+  // Historical PTC dispatch records can carry the birth even when their start is absent.
+  return (type === 'tool/call' || type === 'tool/ptc-dispatch-start' || type === 'tool/ptc-dispatch')
+    && record(data) && data.name === 'ask_user_question'
+}
+
+async function readBirths(
+  directory: string,
+  previous: Receipt,
+  events: readonly SessionEvent[],
+  cut: number,
+): Promise<SessionObservationBirthRange | undefined> {
+  if (previous.version !== 2) return undefined
+  try {
+    const value = await readRecord(birthsPath(directory, previous.generation))
+    if (!record(value) || value.epochId !== previous.epochId || !checksum(value.prefixSha256)) return undefined
+    const range = birthRange(value, previous.firstLiveSequence, cut)
+    if (range.firstSequence !== previous.firstLiveSequence
+      || prefixHash(events, range.eventCount, 2).digest('hex') !== value.prefixSha256) return undefined
+    return range
+  } catch (_error: unknown) {
+    return undefined
+  }
+}
+
+async function writeBirthWitness(path: string, content: string): Promise<void> {
+  const staging = `${path}.${randomUUID()}.tmp`
+  const handle = await open(staging, 'wx', 0o600)
+  try {
+    try {
+      await handle.writeFile(content)
+      await handle.sync()
+    } finally {
+      await handle.close()
+    }
+    await rename(staging, path)
+  } finally {
+    await rm(staging, { force: true })
+  }
+}
+
+/**
+ * Publish an observation receipt while holding the session's write lease.
+ * @param logPath Canonical artifact containing the verified durable prefix.
+ * @param events Physically recovered and logically validated events, including any salvageable records.
+ * @param recoveredEventCount Durable cut excluding uncommitted recovered frame data.
+ * @param publish Publishes a new named file without replacement and syncs its directory entry.
+ * @returns The write epoch and the observer's append witness after the receipt is durable.
+ */
+export async function publishObservationRecovery(
+  logPath: string,
+  events: readonly SessionEvent[],
+  recoveredEventCount: number,
+  publish: (path: string, content: string) => Promise<void>,
+): Promise<ObservationWriter> {
+  const directory = dirname(logPath)
+  const previous = await readPrevious(directory)
+  if (previous !== undefined && (
+    previous.recoveredEventCount > recoveredEventCount
+    || previous.prefixSha256 !== prefixHash(events, previous.recoveredEventCount, previous.version).digest('hex')
+  )) {
+    throw new Error('The last certified observation prefix is unavailable')
+  }
+  const generation = (previous?.generation ?? 0) + 1
+  if (!offset(generation)) throw new Error('Observation generation exhausted')
+  const verifiedBirths = previous === undefined ? undefined : await readBirths(directory, previous, events, recoveredEventCount)
+  const ancestors = previous === undefined ? [] : [
+    ...previous.ancestors,
+    Object.freeze({
+      epochId: previous.epochId,
+      generation: previous.generation,
+      firstSequence: previous.recoveredEventCount,
+      ...verifiedBirths === undefined ? {} : { verifiedBirths },
+    }),
+  ].slice(-ANCESTOR_LIMIT)
+  const recovery = Object.freeze({
+    version: 2 as const,
+    streamId: previous?.streamId ?? SessionObservationToken(randomUUID()),
+    epochId: SessionObservationToken(randomUUID()),
+    generation, recoveredEventCount, firstLiveSequence: events.length, ancestors: Object.freeze(ancestors),
+  })
+  const hash = prefixHash(events, recoveredEventCount, 2)
+  const receipt: Receipt = { ...recovery, prefixSha256: hash.copy().digest('hex') }
+  await publish(join(directory, `${RECEIPT_PREFIX}${generation}.json`), JSON.stringify(receipt) + '\n')
+  for (const event of events.slice(recoveredEventCount)) hash.update(JSON.stringify(event, canonical) + '\n')
+  let eventCount = recovery.firstLiveSequence
+  let witnessPending = false
+  return {
+    recovery,
+    async recordBirths(batch) {
+      for (const event of batch) {
+        hash.update(JSON.stringify(event, canonical) + '\n')
+        witnessPending ||= mayContainTimedBirth(event)
+      }
+      eventCount += batch.length
+      if (!witnessPending) return
+      await writeBirthWitness(birthsPath(directory, generation), JSON.stringify({
+        epochId: recovery.epochId,
+        firstSequence: recovery.firstLiveSequence,
+        eventCount, prefixSha256: hash.copy().digest('hex'),
+      }) + '\n')
+      witnessPending = false
+    },
+  }
+}
