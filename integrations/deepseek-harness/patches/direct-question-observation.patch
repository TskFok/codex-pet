@@ -144,0 +146,39 @@ declare module '@deepseek-ai/dsh-session-projection/types' {
+/** Identity created by the original Host service for a direct question. */
+export type DirectQuestionId = Branded<'DirectQuestionId'>
+
+/** Session attribution retained for the life of a direct question. */
+export interface DirectQuestion {
+  readonly id: DirectQuestionId
+  readonly sessionId: SessionId
+  readonly sessionCreatedAt: number
+  readonly birthTurn: number | null
+  readonly reason: 'answer' | 'approval'
+  readonly startedAt: number
+}
+
+/** Final result of the original direct ask operation. */
+export type DirectQuestionOutcome = 'answered' | 'cancelled' | 'failed'
+
+/** Immutable direct-question change at the owning service's cursor. */
+export type DirectQuestionChange =
+  | { readonly kind: 'started'; readonly cursor: number; readonly request: DirectQuestion }
+  | { readonly kind: 'settled'; readonly cursor: number; readonly request: DirectQuestion; readonly outcome: DirectQuestionOutcome; readonly settledAt: number }
+
+/** Atomic startup state of a direct-question observer. */
+export interface DirectQuestionObservation {
+  readonly snapshot: {
+    readonly version: 1
+    /** UUID of the running question service. Cursors cannot be compared between owners. */
+    readonly ownerId: string
+    /** Last applied direct-question change in this snapshot. */
+    readonly cursor: number
+    /** Every settled change after this cursor through cursor is present. */
+    readonly settledAfter: number
+    /** All open, agent-scoped asks without a tool wait. */
+    readonly active: readonly DirectQuestion[]
+    readonly settled: readonly Extract<DirectQuestionChange, { kind: 'settled' }>[]
+  }
+  /** Stop receiving changes. Safe to call repeatedly and independent of the original ask. */
+  readonly dispose: () => void
+}
+
diff --git a/packages/interaction/user-questions/tests/direct-observation.spec.ts b/packages/interaction/user-questions/tests/direct-observation.spec.ts
new file mode 100644
index 0000000000..48a9a68d10
--- /dev/null
+++ b/packages/interaction/user-questions/tests/direct-observation.spec.ts
@@ -0,0 +1,60 @@
+import { expect, it, onTestFinished } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import AgentRegistry, { type Agent } from '@deepseek-ai/dsh-agent'
+import UserQuestionService, {
+  UserQuestionError,
+  type AskUserQuestionAnswer,
+  type DirectQuestionChange,
+} from '@deepseek-ai/dsh-user-questions'
+import { Session, SessionId } from '@deepseek-ai/dsh-session'
+import SessionProjectionRegistry from '@deepseek-ai/dsh-session-projection'
+
+it('recovers live and settled direct requests through a replacement observer', async () => {
+  const ctx = new Context()
+  await ctx.plugin(SessionProjectionRegistry)
+  await ctx.plugin(AgentRegistry)
+  await ctx.plugin(UserQuestionService)
+  onTestFinished(async () => { await ctx.fiber.dispose() })
+  const id = SessionId('direct-observation')
+  const session = Session.create(id)
+  const agent = { id, session } as Agent
+  ctx.agents.enter(agent)
+  const answer = { answers: [{ id: 'active', selected: ['accepted'] }] }
+  const cancelled = new UserQuestionError('cancelled', 'ASK_CANCELLED')
+  const active = Promise.withResolvers<AskUserQuestionAnswer>()
+  const removed = Promise.withResolvers<AskUserQuestionAnswer>()
+  ctx.on('user-questions/request', request =>
+    request.questions[0]?.id === 'active' ? active.promise : removed.promise)
+
+  const firstChanges: DirectQuestionChange[] = []
+  const first = ctx.userQuestions.observeDirectQuestions((change) => { firstChanges.push(change) })
+  session.append('turn/start', { turn: 1 })
+  const waiting = ctx.userQuestions.ask({ agent, questions: [{ id: 'active', question: 'Private question' }] })
+  session.append('turn/end', { turn: 1, reason: { kind: 'completed' } })
+  const cancelling = ctx.userQuestions.ask({ agent, questions: [{ id: 'idle', question: 'Private question' }] })
+  expect(firstChanges.map(change => [change.kind, change.request.birthTurn])).toEqual([
+    ['started', 1], ['started', null],
+  ])
+  first.dispose()
+
+  removed.reject(cancelled)
+  await expect(cancelling).rejects.toBe(cancelled)
+  const laterChanges: DirectQuestionChange[] = []
+  const later = ctx.userQuestions.observeDirectQuestions((change) => {
+    laterChanges.push(change)
+    throw new Error('observer unavailable')
+  })
+  expect(later.snapshot).toMatchObject({
+    version: 1, cursor: 3, settledAfter: 0,
+    active: [firstChanges[0]?.request],
+    settled: [{ kind: 'settled', cursor: 3, request: firstChanges[1]?.request, outcome: 'cancelled' }],
+  })
+  expect(JSON.stringify(later.snapshot)).not.toContain('Private question')
+  active.resolve(answer)
+  await expect(waiting).resolves.toBe(answer)
+  expect(firstChanges).toHaveLength(2)
+  expect(laterChanges).toMatchObject([
+    { kind: 'settled', cursor: 4, request: firstChanges[0]?.request, outcome: 'answered' },
+  ])
+  later.dispose()
+})
