+/** Observation ownership across a writable handoff whose metadata publication fails. */
+import { mkdtemp, open, readFile, rm } from 'node:fs/promises'
+import type { FileHandle } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { dirname, join } from 'node:path'
+import { expect, it, onTestFinished, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { SESSION_FORMAT_VERSION, SessionId, SessionSeq, type SessionEvent } from '@deepseek-ai/dsh-session'
+import { ToolCallId, createAssistantMessage, createToolResultMessage } from '@deepseek-ai/dsh-llm'
+import * as JsonlSessionPersistence from '@deepseek-ai/dsh-session-persistence-jsonl'
+import { publishObservationRecovery } from '../src/observation-recovery.ts'
+
+function turn(sequence: number, turnId: number): SessionEvent[] {
+  return [
+    { type: 'turn/start', seq: SessionSeq(sequence), time: sequence, data: { turn: turnId } },
+    { type: 'turn/end', seq: SessionSeq(sequence + 1), time: sequence + 1, data: { turn: turnId, reason: { kind: 'completed' } } },
+  ]
+}
+
+function question(sequence: number, type: 'tool/call' | 'tool/ptc-dispatch-start' | 'tool/ptc-dispatch'): SessionEvent {
+  const common = { seq: SessionSeq(sequence), time: sequence }
+  const name = 'ask_user_question'
+  const callId = ToolCallId('question')
+  if (type === 'tool/call') return { ...common, type, data: { turn: 2, step: 1, callId, name, arguments: '{}' } }
+  const data = { rootCallId: ToolCallId('root'), parentCallId: ToolCallId('root'), subCallId: callId, name, arguments: {} }
+  if (type === 'tool/ptc-dispatch-start') return { ...common, type, data } as SessionEvent
+  return { ...common, type, data: { ...data, isError: false, content: [{ type: 'text', text: '{"pending":true}' }] } } as SessionEvent
+}
+
+it.each(['tool/call', 'tool/ptc-dispatch-start'] as const)(
+  'syncs the ordinary log alone and retries the witness for a durable %s birth', async (type) => {
+    const root = await mkdtemp(join(tmpdir(), 'dsh-observation-birth-'))
+    const ctx = new Context()
+    onTestFinished(async () => {
+      await ctx.fiber.dispose()
+      await rm(root, { recursive: true, force: true })
+    })
+    await ctx.plugin(JsonlSessionPersistence, { root, compression: 'none' })
+    const id = SessionId('witness-on-birth')
+    const initial = await ctx.sessionPersistence.create({ version: SESSION_FORMAT_VERSION, id, createdAt: 100, isSeeded: false })
+    await initial.append(turn(0, 1))
+    await initial.close()
+    const path = (await ctx.sessionPersistence.stat(id))?.location
+    if (path?.kind !== 'jsonl') throw new Error('Expected JSONL storage')
+    const file = await open(path.path, 'r')
+    const prototype: Pick<FileHandle, 'sync'> = Object.getPrototypeOf(file)
+    await file.close()
+
+    const writer = await ctx.sessionPersistence.open(id, 'write')
+    const receipt = await writer.prepareObservationRecovery?.()
+    expect(receipt).toBeDefined()
+    const witness = join(dirname(path.path), '.observation-births-v2-1.json')
+    const sync = prototype.sync
+    const writes = vi.spyOn(prototype, 'sync')
+    try {
+      const rootCallId = ToolCallId('root')
+      const askCallId = ToolCallId('question')
+      const call = [{ type: 'tool-call' as const, id: rootCallId, name: 'read', arguments: '{}' }]
+      if (type === 'tool/call') call.push({ type: 'tool-call', id: askCallId, name: 'ask_user_question', arguments: '{}' })
+      await writer.append([
+        { type: 'turn/start', seq: SessionSeq(2), time: 2, data: { turn: 2 } },
+        { type: 'step/start', seq: SessionSeq(3), time: 3, data: { turn: 2, step: 1 } },
+        { type: 'assistant/message', seq: SessionSeq(4), time: 4, surfaceOp: 'append', data: {
+          turn: 2, step: 1, stream: [], message: createAssistantMessage({
+            source: { provider: 'fixture', model: 'offline' }, content: call,
+          }),
+        } },
+        { type: 'tool/call', seq: SessionSeq(5), time: 5, data: { turn: 2, step: 1, callId: rootCallId, name: 'read', arguments: '{}' } },
+      ])
+      expect(writes).toHaveBeenCalledTimes(1)
+      await expect(readFile(witness)).rejects.toMatchObject({ code: 'ENOENT' })
+      writes.mockClear()
+      writes.mockImplementationOnce(function (this: FileHandle) { return sync.call(this) })
+        .mockRejectedValueOnce(new Error('simulated witness sync failure'))
+      await expect(writer.append([question(6, type)])).resolves.toBeUndefined()
+      expect(writes).toHaveBeenCalledTimes(2)
+      await expect(readFile(witness)).rejects.toMatchObject({ code: 'ENOENT' })
+      writes.mockClear()
+      await writer.append([{ type: 'tool/result', seq: SessionSeq(7), time: 7, surfaceOp: 'append', data: {
+        turn: 2, step: 1, message: createToolResultMessage({ callId: rootCallId, content: [], isError: false }),
+      } }])
+      expect(writes).toHaveBeenCalledTimes(2)
+      const confirmed = await readFile(witness, 'utf8')
+      expect(JSON.parse(confirmed)).toMatchObject({ epochId: receipt?.epochId, firstSequence: 2, eventCount: 8 })
+      writes.mockClear()
+      await writer.append([{ type: 'request/header', seq: SessionSeq(8), time: 8, data: {
+        reason: 'initial', header: { config: { provider: 'fixture', model: 'offline' } },
+      } }])
+      expect(writes).toHaveBeenCalledTimes(1)
+      expect(await readFile(witness, 'utf8')).toBe(confirmed)
+    } finally {
+      writes.mockRestore()
+      await writer.close()
+    }
+    const successor = await ctx.sessionPersistence.open(id, 'write')
+    try {
+      expect(await successor.prepareObservationRecovery?.()).toMatchObject({
+        recoveredEventCount: 9,
+        ancestors: [{ epochId: receipt?.epochId, verifiedBirths: { firstSequence: 2, eventCount: 8 } }],
+      })
+    } finally {
+      await successor.close()
+    }
+  },
+)
+
+it('marks a legacy pending dispatch without a start as a potential birth', async () => {
+  const root = await mkdtemp(join(tmpdir(), 'dsh-legacy-dispatch-birth-'))
+  onTestFinished(() => rm(root, { recursive: true, force: true }))
+  const writer = await publishObservationRecovery(join(root, 'legacy.jsonl'), [], 0, async () => {})
+  await writer.recordBirths([question(0, 'tool/ptc-dispatch')])
+  const witness = JSON.parse(await readFile(join(root, '.observation-births-v2-1.json'), 'utf8'))
+  expect(witness).toMatchObject({ epochId: writer.recovery.epochId, firstSequence: 0, eventCount: 1 })
+})
+
+it('only attributes the proven birth interval when an unsealed writer appends before the next recovery', async () => {
+  const root = await mkdtemp(join(tmpdir(), 'dsh-order-'))
+  const ctx = new Context()
+  onTestFinished(async () => {
+    await ctx.fiber.dispose()
+    await rm(root, { recursive: true, force: true })
+  })
+  await ctx.plugin(JsonlSessionPersistence, { root, compression: 'none' })
+  const id = SessionId('between-writers')
+  const initial = await ctx.sessionPersistence.create({ version: SESSION_FORMAT_VERSION, id, createdAt: 100, isSeeded: false })
+  await initial.append(turn(0, 1))
+  await initial.close()
+
+  const first = await ctx.sessionPersistence.open(id, 'write')
+  const a = await first.prepareObservationRecovery?.()
+  expect(a).toBeDefined()
+  const withBirth = [turn(2, 2)[0]!, question(3, 'tool/ptc-dispatch-start'), question(4, 'tool/ptc-dispatch'), turn(4, 2)[1]!]
+  await first.append(withBirth)
+  await first.close()
+
+  const next = await ctx.sessionPersistence.open(id, 'write')
+  const path = (await ctx.sessionPersistence.stat(id))?.location
+  if (path?.kind !== 'jsonl') throw new Error('Expected JSONL storage')
+  const file = await open(path.path, 'r')
+  const prototype: Pick<FileHandle, 'sync'> = Object.getPrototypeOf(file)
+  await file.close()
+  const sync = prototype.sync
+  let syncCalls = 0
+  const failure = vi.spyOn(prototype, 'sync').mockImplementation(async function (this: FileHandle) {
+    if (++syncCalls === 2) throw new Error('simulated observation staging sync failure')
+    await sync.call(this)
+  })
+  try {
+    expect(await next.prepareObservationRecovery?.()).toBeUndefined()
+  } finally {
+    failure.mockRestore()
+  }
+  await next.append(turn(6, 3))
+  await next.close()
+
+  const last = await ctx.sessionPersistence.open(id, 'write')
+  try {
+    expect((await last.read()).events).toEqual([...turn(0, 1), ...withBirth, ...turn(6, 3)])
+    expect(await last.prepareObservationRecovery?.()).toMatchObject({
+      version: 2, generation: 2, recoveredEventCount: 8, firstLiveSequence: 8,
+      ancestors: [{ epochId: a?.epochId, generation: 1, firstSequence: 2,
+        verifiedBirths: { firstSequence: 2, eventCount: 6 } }],
+    })
+  } finally {
+    await last.close()
+  }
+})
