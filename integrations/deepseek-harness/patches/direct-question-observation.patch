@@ -0,0 +1,98 @@
+/** Host-only, service-lifetime observation of asks without a tool wait. */
+import { randomUUID } from 'node:crypto'
+import { brandString } from '@deepseek-ai/dsh-brand'
+import type { DirectQuestion, DirectQuestionChange, DirectQuestionId, DirectQuestionObservation, DirectQuestionOutcome } from './types.ts'
+
+type Listener = (change: DirectQuestionChange) => void | Promise<void>
+type Settled = Extract<DirectQuestionChange, { kind: 'settled' }>
+
+const SETTLEMENT_LIMIT = 1_024
+
+/** Records the original ask's lifecycle independently of answerer and observer lifetimes. */
+export class DirectQuestionObserver {
+  private readonly ownerId = randomUUID()
+  private readonly active = new Map<DirectQuestionId, DirectQuestion>()
+  private readonly settled = new Map<number, Settled>()
+  private readonly listeners = new Map<Listener, number>()
+  private readonly changes: DirectQuestionChange[] = []
+  private cursor = 0
+  private settledAfter = 0
+  private closed = false
+
+  constructor(private readonly reportFailure: () => void) {}
+
+  /**
+   * Capture state and subscribe at the same cursor.
+   * @param listener Receives future changes in cursor order.
+   * @returns A snapshot and an idempotent unsubscribe operation.
+   */
+  observe(listener: Listener): DirectQuestionObservation {
+    const subscription: Listener = change => listener(change)
+    const snapshot = {
+      version: 1 as const,
+      ownerId: this.ownerId,
+      cursor: this.cursor,
+      settledAfter: this.settledAfter,
+      active: [...this.active.values()],
+      settled: [...this.settled.values()],
+    }
+    if (!this.closed) this.listeners.set(subscription, snapshot.cursor)
+    return { snapshot, dispose: () => { this.listeners.delete(subscription) } }
+  }
+
+  /**
+   * Register an ask immediately before answerer dispatch.
+   * @param owner Session identity and birth information.
+   * @returns The new immutable identity, or undefined if the observation owner was disposed.
+   */
+  start(owner: Omit<DirectQuestion, 'id' | 'startedAt'>): DirectQuestion | undefined {
+    if (this.closed) return undefined
+    const request = Object.freeze({ ...owner, id: brandString<DirectQuestionId>(randomUUID()), startedAt: Date.now() })
+    this.active.set(request.id, request)
+    this.publish(Object.freeze({ kind: 'started', request, cursor: ++this.cursor }))
+    return request
+  }
+
+  /**
+   * Record the final result of the original ask.
+   * @param request The identity captured at entry.
+   * @param outcome The original ask's terminal result.
+   */
+  settle(request: DirectQuestion, outcome: DirectQuestionOutcome): void {
+    if (!this.active.delete(request.id)) return
+    const change = Object.freeze({ kind: 'settled' as const, request, outcome, cursor: ++this.cursor, settledAt: Date.now() })
+    this.settled.set(change.cursor, change)
+    if (this.settled.size > SETTLEMENT_LIMIT) {
+      const oldest = this.settled.keys().next().value
+      if (oldest !== undefined) {
+        this.settled.delete(oldest)
+        this.settledAfter = oldest
+      }
+    }
+    this.publish(change)
+  }
+
+  /** Discard this service's in-memory observation scope. */
+  dispose(): void {
+    this.closed = true
+    this.listeners.clear()
+    this.active.clear()
+    this.settled.clear()
+  }
+
+  private publish(change: DirectQuestionChange): void {
+    this.changes.push(change)
+    if (this.changes.length > 1) return
+    for (const next of this.changes) {
+      for (const [listener, cut] of this.listeners) {
+        if (next.cursor <= cut) continue
+        try {
+          void Promise.resolve(listener(next)).catch((_error: unknown) => { this.reportFailure() })
+        } catch (_error: unknown) {
+          this.reportFailure()
+        }
+      }
+    }
+    this.changes.length = 0
+  }
+}
