+ctx.sessions.announce(session)
+const seen = []
+ctx.on('session/event', (owner, event) => { if (session === owner) seen.push(event) })
+session.append('turn/start', { turn: 2 })
+session.append('turn/end', { turn: 2, reason: { kind: 'completed' } })
+writeSync(1, JSON.stringify({ generation, seedCount: session.firstLiveSeq, seen }) + '\n')
+process.kill(process.pid, 'SIGKILL')
