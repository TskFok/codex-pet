{
  "name": "@codex-pet/deepseek-integration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./open-session": "./dist/open-session.js"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.client.json --noEmit && node build-client.mjs && node verify-artifacts.mjs && node prepare-template.mjs",
    "create-install": "node create-install.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0 || ^4.2.0-alpha.1",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.1 || ^0.2.3-alpha.1",
    "@deepseek-ai/dsh-user-approval": "^0.2.2-rc.1 || ^0.2.3-alpha.1",
    "@deepseek-ai/dsh-user-questions": "^0.2.2-rc.1 || ^0.2.3-alpha.1",
    "@deepseek-ai/dsh-session-projection": "^0.2.2-rc.1 || ^0.2.3-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1 || ^0.2.3-alpha.1",
    "@deepseek-ai/dsh-tool-executor-ptc": "^0.2.2-rc.1 || ^0.2.3-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-ptc": "0.2.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.1",
    "@deepseek-ai/dsh-user-questions": "0.2.2-rc.1",
    "@types/node": "24.10.1",
    "esbuild": "0.27.0",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "files": [
    "dist",
    "README.md",
    "compatibility.json"
  ]
}
