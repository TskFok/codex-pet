diff --git a/apps/desktop/src/session-deep-link.ts b/apps/desktop/src/session-deep-link.ts
new file mode 100644
index 0000000000..c96e2ac1ca
--- /dev/null
+++ b/apps/desktop/src/session-deep-link.ts
@@ -0,0 +1,55 @@
+/** 桌面启动期间保留经过验证的会话跳转目标，不领取会话或启动任务。 */
+
+/**
+ * 解析单个编码会话ID；拒绝额外路径、凭据、查询、片段和无效编码。
+ * @param input - 操作系统提供的不可信URL。
+ * @returns 有效会话标识，否则undefined。
+ */
+export function parseSessionDeepLink(input: string): string | undefined {
+  try {
+    const url = new URL(input)
+    if (url.protocol !== 'dsh:' || url.hostname !== 'session' || url.username !== '' || url.password !== ''
+      || url.port !== '' || url.search !== '' || url.hash !== '' || !/^\/[^/]+$/.test(url.pathname)) return undefined
+    const id = decodeURIComponent(url.pathname.slice(1))
+    return id.trim() !== '' && !/[\u0000-\u001f\u007f]/.test(id) && id.length <= 1024 ? id : undefined
+  } catch (_error: unknown) {
+    // 无效URL不进入队列，保持原窗口和会话不变。
+    return undefined
+  }
+}
+
+/** 由唯一Electron主进程持有；Client明确确认后移除目标，渲染重载不会提前消费。 */
+export class DesktopSessionLinks {
+  private readonly targets = new Map<number, string>()
+  private serial = 0
+  private notify: (() => void) | undefined
+
+  /** @param url - 不可信系统URL；无效URL不产生副作用。 */
+  accept(url: string): void {
+    const sessionId = parseSessionDeepLink(url)
+    if (sessionId === undefined) return
+    // 外部协议最多保留64个尚未确认目标，限制操作系统输入占用内存。
+    if (this.targets.size >= 64) {
+      console.warn('会话入口队列已满，请在宿主就绪后重试')
+      return
+    }
+    this.targets.set(++this.serial, sessionId)
+    this.notify?.()
+  }
+
+  /** @param argv - 冷启动或Windows second-instance的完整参数；其他参数忽略。 */
+  acceptArgv(argv: readonly string[]): void { for (const arg of argv) this.accept(arg) }
+
+  /** @param notify - 主窗口可用后的唤醒回调；附加时立刻检查早到目标。 */
+  attach(notify: () => void): void { this.notify = notify; notify() }
+
+  /** @param workspaceReady - false时保留全部目标，true时返回副本。
+   * @returns 尚未确认的目标；不会把仅唤起报告为已定位。
+   */
+  pending(workspaceReady: boolean): { id: number; sessionId: string }[] {
+    return workspaceReady ? [...this.targets].map(([id, sessionId]) => ({ id, sessionId })) : []
+  }
+
+  /** @param id - Client完成或明确拒绝的目标序号；未知序号没有副作用。 */
+  acknowledge(id: number): void { this.targets.delete(id) }
+}
