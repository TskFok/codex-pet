index 0000000000..1e7e615047
--- /dev/null
+++ b/packages/session/session-persistence-jsonl/tests/observation-recovery.e2e.ts
@@ -0,0 +1,73 @@
+/** A real abrupt process exit leaves an observed tail outside the next writer's durable prefix. */
+import { spawnSync } from 'node:child_process'
+import { mkdtemp, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { dirname, join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { expect, it, onTestFinished } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { SESSION_FORMAT_VERSION, SessionId, SessionSeq } from '@deepseek-ai/dsh-session'
+import * as JsonlSessionPersistence from '@deepseek-ai/dsh-session-persistence-jsonl'
+
+const WRITER = fileURLToPath(new URL('./fixtures/recovery-tail-writer.mjs', import.meta.url))
+
+it.skipIf(process.platform === 'win32')('proves the durable prefix and advances the writer generation after SIGKILL', { timeout: 25_000 }, async () => {
+  const root = await mkdtemp(join(tmpdir(), 'dsh-observation-recovery-'))
+  const ctx = new Context()
+  onTestFinished(async () => {
+    await ctx.fiber.dispose()
+    await rm(root, { recursive: true, force: true })
+  })
+  await ctx.plugin(JsonlSessionPersistence, { root, compression: 'none' })
+  const id = SessionId('recovery-test')
+  const writer = await ctx.sessionPersistence.create({
+    version: SESSION_FORMAT_VERSION, id, createdAt: 100, isSeeded: false,
+  })
+  await writer.append([{ seq: SessionSeq(0), type: 'turn/start', time: 1, data: { turn: 1 } }, {
+    seq: SessionSeq(1), type: 'turn/end', time: 2, data: { turn: 1, reason: { kind: 'completed' } },
+  }, { seq: SessionSeq(2), type: 'session/end-seed', time: 3, data: {} }])
+  await writer.close()
+
+  const crash = spawnSync(process.execPath, [WRITER, root, id], { encoding: 'utf8', timeout: 15_000 })
+  expect(crash.signal, crash.stderr).toBe('SIGKILL')
+  const observed = JSON.parse(crash.stdout)
+  expect(observed.seen).toMatchObject([
+    { type: 'turn/start', seq: 3, data: { turn: 2 } },
+    { type: 'turn/end', seq: 4, data: { turn: 2 } },
+  ])
+
+  const recovered = await ctx.sessionPersistence.open(id, 'write')
+  const prefix = await recovered.read()
+  const second = await recovered.prepareObservationRecovery?.()
+  expect(prefix.events.map(event => event.seq)).toEqual([0, 1, 2])
+  await recovered.append([{ seq: SessionSeq(3), type: 'turn/start', time: 4, data: { turn: 2 } }])
+  expect((await recovered.read()).events.at(-1)).toMatchObject({
+    type: 'turn/start', seq: 3, data: { turn: 2 },
+  })
+  expect(observed.generation).toMatchObject({ version: 1, generation: 1, recoveredEventCount: 3 })
+  expect(second).toMatchObject({
+    version: 1, streamId: observed.generation.streamId, generation: 2, recoveredEventCount: 3,
+  })
+  await recovered.close()
+
+  const grown = await ctx.sessionPersistence.open(id, 'write')
+  expect(await grown.prepareObservationRecovery?.()).toMatchObject({
+    version: 1, generation: 3, recoveredEventCount: 4,
+    ancestors: [
+      { epochId: observed.generation.epochId, generation: 1, firstSequence: 3 },
+      { epochId: second?.epochId, generation: 2, firstSequence: 3 },
+    ],
+  })
+  await grown.close()
+
+  const location = (await ctx.sessionPersistence.stat(id))?.location
+  if (location?.kind !== 'jsonl') throw new Error('Expected the public JSONL artifact location')
+  await writeFile(join(dirname(location.path), '.observation-v1-3.json'), '{invalid}')
+  const uncertain = await ctx.sessionPersistence.open(id, 'write')
+  expect(await uncertain.prepareObservationRecovery?.()).toBeUndefined()
+  await uncertain.append([{
+    seq: SessionSeq(4), type: 'turn/end', time: 5, data: { turn: 2, reason: { kind: 'completed' } },
+  }])
+  expect((await uncertain.read()).events.map(event => event.seq)).toEqual([0, 1, 2, 3, 4])
+  await uncertain.close()
+})
